{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "app",

  "workers_dev": true,
  "preview_urls": true,

  "compatibility_date": "2025-08-27",

  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],

  "main": "./worker/index.ts",

  "assets": {
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/ffmpeg/*",
      "/_vinext/image"
    ]
  },

  "images": {
    "binding": "IMAGES"
  },

  "r2_buckets": [
    {
      "binding": "FFMPEG_ASSETS",
      "bucket_name": "assets"
    }
  ]
}
